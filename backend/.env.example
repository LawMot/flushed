# Copy this file to ".env" and fill in your real values.

# Your MongoDB Atlas connection string.
# In the Atlas website: Cluster -> "Connect" -> "Drivers" -> copy the string.
# Replace <username>, <password>, and add your database name (e.g. "flushed") before the "?".
# Example:
# MONGODB_URI=mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/flushed?retryWrites=true&w=majority
MONGODB_URI=

# Port the backend server listens on.
PORT=5000

# Allowed origin for CORS (your Vite frontend). Use * to allow all during development.
CLIENT_ORIGIN=http://localhost:5173
